{
  "name": "@smaltworks/smaltai",
  "version": "0.0.0",
  "private": true,
  "description": "AI for the smalt apps: a router to the user's own gateways, grants, a local log and an agent loop.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stenhoor/smaltai.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "default": "./dist/store.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "deps": "node scripts/fetch-packed.mjs",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "node scripts/fetch-packed.mjs --check && node node_modules/typescript7/bin/tsc -p .",
    "test": "node scripts/fetch-packed.mjs --check && npm run build && node --test test/*.test.ts",
    "test:browser": "npm run build && node test/browser/run.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "peerDependencies": {
    "@smaltworks/smaltts": ">=0.0.1 <0.1.0",
    "smaltdb": ">=0.9.0 <0.10.0"
  },
  "peerDependenciesMeta": {
    "@smaltworks/smaltts": {
      "optional": true
    },
    "smaltdb": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3",
    "typescript7": "npm:typescript@~7.0.2",
    "vitepress": "1.6.4"
  }
}
